{
  "name": "fridge-board",
  "version": "0.1.0",
  "private": true,
  "description": "Household fridge inventory and meal ideas, edited from phones and shown on an e-ink display.",
  "type": "module",
  "scripts": {
    "dev": "firebase emulators:start --project demo-fridge-board",
    "test": "firebase emulators:exec --project demo-fridge-board --only firestore \"node --test tests/*.test.js\"",
    "test:e2e": "firebase emulators:exec --project demo-fridge-board --only auth,firestore,hosting \"node tests/e2e.mjs\"",
    "deploy": "firebase deploy --only hosting,firestore"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.34.1",
    "playwright": "^1.63.0"
  }
}
